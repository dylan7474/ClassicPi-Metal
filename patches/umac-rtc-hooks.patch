# Wire umac's VIA port B to a Mac Plus clock chip (RTC + 20 bytes of PRAM).
#
# umac ignores port B bits [2:0] (the RTC's data, clock and /enable lines)
# and always reads 0, so the Mac's clock starts at 1904 every boot and
# PRAM settings are lost.  These two hooks pass the lines to
# umac_rtc_lines() and read the data bit from umac_rtc_data_in(); the chip
# itself is src/mac_rtc.c in ClassicPi-Metal.  Applied by the top-level
# Makefile to each target's copy of umac (the submodule stays untouched).
#
--- a/src/main.c	2026-11-20 18:16:14.969385906 +0000
+++ b/src/main.c	2026-11-20 18:16:15.005637069 +0000
@@ -158,6 +158,10 @@
         oldval = val;
 }
 
+/* ClassicPi-Metal: Mac Plus clock chip (RTC + PRAM), in mac_rtc.c */
+void    umac_rtc_lines(uint8_t lines);  /* [0] data, [1] clock, [2] /enable */
+uint8_t umac_rtc_data_in(void);
+
 static void     via_rb_changed(uint8_t val)
 {
         // 7 = sndres (sound enable/disable)
@@ -166,7 +170,7 @@
         // 4 = mouse4 (in, mouse X2)
         // 3 = mouse7 (in, 0 = button pressed)
         // [2:0] = RTC controls
-        (void)val;
+        umac_rtc_lines(val & 7);        /* ClassicPi-Metal: mac_rtc.c */
 }
 
 static uint8_t  via_ra_in(void)
@@ -184,6 +188,7 @@
         // Mouse not pressed!
         if (!via_mouse_pressed)
                 v |= (1 << 3);
+        v |= umac_rtc_data_in() & 1;    /* ClassicPi-Metal: RTC data, bit 0 */
         return v;
 }
 
